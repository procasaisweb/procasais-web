# Copie este arquivo para ".env" e preencha com seus valores reais.
# O ".env" nunca deve ser commitado nem exposto ao navegador — ele fica
# só no servidor.

# Project Settings → API, no seu projeto Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Project Settings → API → "service_role" (secret) — NUNCA a "anon" aqui
SUPABASE_SERVICE_ROLE_KEY=

# E-mails com permissão de acessar /admin.html e cadastrar usuários
# (separados por vírgula, sem espaço)
ADMIN_EMAILS=voce@exemplo.com

# Servidor SMTP usado para enviar a senha inicial e o link de troca de senha
# Exemplo com Gmail: host smtp.gmail.com, porta 587, use uma "Senha de app"
# (não a senha normal da conta). Qualquer provedor SMTP funciona (Brevo,
# SendGrid, Amazon SES, etc.)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@exemplo.com
SMTP_PASS=
SMTP_FROM="Procasais Web <naoresponda@exemplo.com>"

PORT=3000
